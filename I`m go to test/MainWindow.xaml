<Window x:Class="I_m_go_to_test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:I_m_go_to_test"
        mc:Ignorable="d"
        Title="Чудо Обувь" Height="450" Width="800" FontFamily="Calibri" Icon="/Res/Чудо Обувь.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Source="/Res/Чудо Обувь.png" HorizontalAlignment="Left" Grid.Row="0"/>
        <Button Name="BtnBack" Content="Назад" Grid.Row="0" Height="30" Width="100" FontSize="20" HorizontalAlignment="Right"
                VerticalAlignment="Center" Margin="10" Click="BtnBack_Click"/>
        <TextBlock Text="Чудо обувь" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Frame Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered" Grid.Row="1"/>
    </Grid>
</Window>
