<Page x:Class="I_m_go_to_test.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:I_m_go_to_test"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Обувь" FontFamily="Calibri">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox Name="TBoxSearch" Grid.Row="0" Height="30" Width="200" 
                 HorizontalAlignment="Left" TextChanged="TBoxSearch_TextChanged"/>
            <TextBlock Text="  Категория: " FontSize="15"/>
            <ComboBox Name="ComboFilBox" Width="125" SelectionChanged="ComboFilBox_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="Все категории"/>
                <ComboBoxItem Content="Детская обувь"/>
                <ComboBoxItem Content="Женская обувь"/>
                <ComboBoxItem Content="Мужская обувь"/>
            </ComboBox>
            <TextBlock Text="  Сортировка: " FontSize="15"/>
            <ComboBox Name="ComboSortBox" Width="125" SelectedIndex="0" SelectionChanged="ComboSortBox_SelectionChanged">
                <ComboBoxItem Content="По умолчанию"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
        </StackPanel>
        <ListView Name="ProductView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить в корзину"
                              Click="MenuAddProduct_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        
                        <Image Source="{Binding PhotoPath}" Grid.RowSpan="5" Grid.Column="0" Height="100" Width="100"/>
                        
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" FontSize="20"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="15">
                            <Run Text="Категория: "/>
                            <Run Text="{Binding Category.Category_name}"/>
                            <Run Text="Подкатегория: "/>
                            <Run Text="{Binding Subcategory.Subcategory_name}"/>
                            <Run Text="Производство: "/>
                            <Run Text="{Binding Production.Production1}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="15">
                                <Run Text="Состав: "/>
                                <Run Text="{Binding Compound}"/>
                            </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="15">
                                <Run Text="Описание:"/>
                                <Run Text="{Binding Description}"/>
                        </TextBlock>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Размерный ряд: " FontSize="15"/>

                            <ItemsControl ItemsSource="{Binding ProductItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="15">
                                            <Run Text="{Binding Size.Size1}"/>
                                            <Run Text="("/>
                                            <Run Text="{Binding QuantityStock}"/>
                                            <Run Text="шт.) "/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1"
            Orientation="Horizontal">

                            <TextBlock Text="Количество размеров: " FontSize="15"/>

                            <TextBlock Text="{Binding ProductItems.Count}"
               FontSize="15"/>

                            <TextBlock Text="  Цена: " FontSize="15"/>

                            <TextBlock Text="{Binding Price}"
               FontSize="15"/>

                        </StackPanel>


                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Name="ZakazBtn" Content="Корзина" Grid.Row="2" Width="150"
                FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Click="ZakazBtn_Click"/>
    </Grid>
</Page>
