<Page x:Class="I_m_go_to_test.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:I_m_go_to_test"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Authorization" FontFamily="Calibri">

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Gray"
                BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel Margin="30" Width="300">
                <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0 0 0 10"/>
                <TextBlock Text="Логин: "/>
                <TextBox Name="LoginEnter" Margin="0 0 0 15" Height="28"
                     VerticalContentAlignment="Center"/>
                <Button Name="LoginButton" Content="Войти" Click="LoginButton_Click"
                        Height="32" Margin="0 0 0 10"/>
                <Button Name="GuestButton" Content="Войти как гость" Height="32"
                        Click="GuestButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
