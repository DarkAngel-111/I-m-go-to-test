<Window x:Class="I_m_go_to_test.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина"
        Height="450" Width="850"
        WindowStartupLocation="CenterScreen"
        FontFamily="Calibri">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина товаров"
                   FontSize="25"
                   HorizontalAlignment="Center"/>

        <DataGrid Name="CartGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding Size}"
                                    Width="80"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price}"
                                    Width="100"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Sum}"
                                    Width="100"/>

                <DataGridTemplateColumn Header="Удалить" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                                    Click="Delete_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <TextBlock Name="TotalText"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="10"/>

            <Button Content="Оформить заказ"
                    Width="170"
                    Height="35"
                    Margin="10"
                    Click="Order_Click"/>

            <Button Content="Закрыть"
                    Width="100"
                    Height="35"
                    Margin="10"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>