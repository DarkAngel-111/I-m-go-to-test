<Window x:Class="I_m_go_to_test.AddCartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление в корзину"
        Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <TextBlock Name="ProductNameText"
                   FontSize="18"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <TextBlock Text="Выберите размер:"
                   FontSize="15"/>

        <ComboBox Name="SizeBox"
                  Height="30"
                  DisplayMemberPath="Size.Size1"
                  Margin="0,5,0,15"/>

        <TextBlock Text="Количество:"
                   FontSize="15"/>

        <TextBox Name="QuantityBox"
                 Text="1"
                 Height="30"
                 Margin="0,5,0,15"/>

        <Button Content="Добавить в корзину"
                Height="35"
                Background="#73B5B5"
                Click="Add_Click"/>

    </StackPanel>
</Window>